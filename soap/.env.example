# =====================================================================
# soap/.env.example — plantilla de configuracion del microservicio
#
#   cp .env.example .env      y escriba los valores reales en .env
#
# ESTE ARCHIVO SI SE PUBLICA. El .env que usted cree a partir de el NO:
# esta en soap/.gitignore y debe seguir estandolo.
# =====================================================================

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=5001
DEBUG=false
API_PREFIX=/api

# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=library_db
PGUSER=library_user
PGSCHEMA=library

# CAMBIEME. Contrasena del rol de PostgreSQL.
# El enunciado de la practica fija 777 para el entorno local; en un
# servidor use una contrasena larga y aleatoria.
PGPASSWORD=CAMBIEME_contrasena_de_postgres

DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------
# CORS — el servicio se consume desde clientes de otro dominio
# ---------------------------------------------------------------------
# "*" permite cualquier origen. En produccion enumere los dominios:
#   CORS_ORIGINS=https://libreria.ejemplo.mx,http://localhost:3000
CORS_ORIGINS=*
CORS_MAX_AGE=86400

# ---------------------------------------------------------------------
# Representacion
# ---------------------------------------------------------------------
# Formato cuando el cliente no pide ninguno (?format= o cabecera Accept).
DEFAULT_FORMAT=json
CURRENCY=MXN
XML_NAMESPACE=urn:library:catalog:1.0
XML_VERSION=1.0

DEFAULT_LIMIT=50
MAX_LIMIT=200
