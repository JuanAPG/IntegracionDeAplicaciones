# Shared environment configuration for all microservices and clients.
# Copy this file to .env and fill in real values. Service-specific settings
# (HOST, PORT, ...) live in each service's own .env.example; only the
# SHARED secrets below must be identical everywhere.

# JWT signing secret — MUST be identical across all services.
# Generate a new one with: python3 -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=1

# Flask session signing (login service). Different from JWT_SECRET.
# Generate with: python3 -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=change-me

# PostgreSQL (shared across all services)
PGHOST=localhost
PGPORT=5432
PGDATABASE=library_db
PGUSER=library_user
PGPASSWORD=
PGSCHEMA=library
