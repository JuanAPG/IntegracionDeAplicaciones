# =====================================================================
# .env.example — plantilla del .env COMPARTIDO de la raiz del repo
#
#   cp .env.example .env      y escriba los valores reales en .env
#
# ESTE ARCHIVO SI SE PUBLICA. El .env que usted cree a partir de el NO:
# la linea `.env` esta en .gitignore (junto con `!.env.example`) y debe
# seguir estandolo. Nunca escriba una credencial real aqui.
#
# QUE ES ESTE ARCHIVO
#   Los seis microservicios leen su configuracion con la misma funcion
#   (packages/library_common/library_common/env.py), que carga DOS .env
#   con esta precedencia:
#
#       entorno real (systemd, contenedor, CI)
#         >  .env de la RAIZ del repo      <- este archivo
#              >  .env del propio servicio
#
#   override=False en ambos: lo que ya viene del entorno real manda y el
#   .env solo rellena huecos. Aqui va lo COMPARTIDO —el secreto del JWT,
#   Redis, PostgreSQL y los tiempos de expiracion— para escribirlo UNA
#   vez en lugar de seis. Lo propio de cada servicio (HOST, PORT,
#   API_PREFIX, XML_NAMESPACE, CORS del cliente concreto) vive en el
#   .env de ese servicio.
#
#   Todos los nombres de abajo los lee de verdad
#   packages/library_common/library_common/settings.py. Si agrega una
#   variable que settings.py no lee, no tendra ningun efecto.
#
# LOS SEIS SERVICIOS Y SUS PUERTOS
#   login 5000 · books 5001 · users 5002 · authors 5003 ·
#   pedidos 5004 · pagos 5005          (el monolito web usa el 3000)
#
# EN LA INSTANCIA
#   El archivo se despliega como /opt/library/<servicio>/.env (o uno
#   comun) y SIEMPRE con `chmod 600`: contiene las contrasenas de
#   PostgreSQL y de Redis y el secreto que firma todos los tokens.
# =====================================================================


# =====================================================================
# 1. JWT — el secreto compartido  (CAMBIELO)
# =====================================================================
# Este es el valor mas delicado del proyecto. login FIRMA los tokens con
# el; los otros cinco servicios los VERIFICAN con el. Por eso tiene que
# ser IDENTICO en los seis: si books tiene un secreto distinto al de
# login, todo token valido le parecera falsificado y respondera 401 a
# cada escritura, sin que ningun log diga por que.
#
# Y como es simetrico (HS256), quien conozca el secreto puede FABRICAR
# un token de administrador. No es una contrasena de servicio: es la
# llave maestra. Generela asi y pegue el MISMO valor en todas partes:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#
# JWT_SECRET_KEY es el nombre actual. JWT_SECRET sigue aceptandose como
# nombre anterior para no romper los despliegues que ya existian; si
# estan los dos, gana JWT_SECRET_KEY. Use solo el nuevo en despliegues
# nuevos.
JWT_SECRET_KEY=CAMBIEME_secreto_jwt_compartido

# Algoritmo de firma. HS256 = secreto simetrico compartido, que es lo
# que corresponde aqui porque emisor y verificadores son nuestros y
# estan en la misma instancia. Dejelo como esta salvo que migre a un par
# de llaves (RS256), lo que obligaria a repartir la publica.
JWT_ALGORITHM=HS256

# Emisor (claim `iss`). Los verificadores lo comprueban, de modo que un
# token firmado por otro sistema con el mismo secreto no cuela. Si lo
# cambia, cambielo en los seis a la vez. Se puede dejar.
JWT_ISSUER=library-login-service


# =====================================================================
# 2. Firma de la cookie de sesion de Flask  (CAMBIELO)
# =====================================================================
# SOLO la usa el microservicio login, y es DISTINTA del secreto del JWT:
# son dos mecanismos separados. El JWT viaja en Authorization: Bearer y
# lo verifican todos; esta firma solo evita que alguien manipule la
# cookie de sesion del navegador. Si fueran la misma, un fallo en
# cualquiera de las dos comprometeria la otra.
#
#     python3 -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=CAMBIEME_secreto_de_sesion_flask


# =====================================================================
# 3. Redis — sesiones, revocacion de JWT y cache  (CAMBIE LA CONTRASENA)
# =====================================================================
# Formato EXACTO (Redis no tiene usuario por omision, de ahi los dos
# puntos pegados al `//`, con el campo de usuario vacio):
#
#     redis://:password@host:6379/0
#
# El `0` final es el numero de base de datos dentro de Redis.
#
# POR QUE 127.0.0.1 AQUI
#   En la VM, Redis escucha en 0.0.0.0 (bind) para que usted pueda
#   depurar con redis-cli desde su Mac — ver docs/06_despliegue_redis.md.
#   Eso NO significa que los servicios deban salir por la IP publica:
#   corren en la misma maquina, asi que se conectan por la interfaz de
#   loopback. Es mas rapido, no sale al exterior y sigue funcionando
#   cuando la IP efimera de GCP cambia (que cambia a menudo).
#
# La contrasena debe ser la misma que el `requirepass` de
# /etc/redis/redis.conf. Generela larga y aleatoria:
#
#     python3 -c "import secrets; print(secrets.token_urlsafe(32))"
REDIS_URL=redis://:CAMBIEME_contrasena_de_redis@127.0.0.1:6379/0

# Segundos para ABRIR la conexion. Corto a proposito: si Redis esta
# caido, mas vale enterarse en 2 s y devolver 503 (o degradarse) que
# dejar colgada la peticion del usuario.
REDIS_CONNECT_TIMEOUT=2.0

# Segundos de espera de una respuesta ya con la conexion abierta. Mismo
# criterio: ninguna operacion nuestra sobre Redis es lenta, de modo que
# pasar de 2 s significa que algo va mal, no que haga falta paciencia.
REDIS_SOCKET_TIMEOUT=2.0

# Tras un fallo, el servicio NO reintenta Redis durante estos segundos:
# se degrada de inmediato y vuelve a probar pasado el enfriamiento. Sin
# esto, con Redis caido cada peticion pagaria otra vez el timeout de
# conexion y el servicio entero se volveria lentisimo.
REDIS_RETRY_COOLDOWN=5.0

# Tope de conexiones del pool por PROCESO. Con `gunicorn --workers 3`
# son 3 procesos por servicio, asi que el consumo real es 3 x este
# numero por servicio. Subalo solo si ve esperas en el pool.
REDIS_MAX_CONNECTIONS=20

# Prefijo opcional delante de TODAS las claves. Vacio esta bien con un
# Redis dedicado. Pongale algo (por ejemplo `prod:`) si varios entornos
# —pruebas y produccion— comparten el mismo servidor Redis: evita que
# las sesiones de uno pisen las del otro.
REDIS_KEY_PREFIX=


# =====================================================================
# 4. Tiempos de expiracion — son coherentes entre si A PROPOSITO
# =====================================================================
# La idea: el token de ACCESO es corto para que una fuga dure poco; el
# REFRESH y la SESION duran lo mismo (8 h, una jornada) para que el
# usuario no tenga que volver a autenticarse a media tarde. Si cambia
# uno, revise los otros: descuadrarlos produce fallos raros, como una
# sesion viva cuyo refresh ya caduco.

# Vida del token de acceso, en minutos. 30 lo fija el enunciado de la
# practica. Es la ventana en la que sirve un token robado.
JWT_ACCESS_TTL_MINUTES=30

# Vida del refresh token, en horas. Vive en Redis y es de UN SOLO USO:
# al canjearlo se invalida y se emite otro. Asi, si alguien se queda con
# un refresh viejo, al usarlo delata el robo en lugar de abrir la puerta.
JWT_REFRESH_TTL_HOURS=8

# Vida de la sesion en Redis, en horas. Ventana DESLIZANTE: se renueva
# con cada peticion, de modo que 8 h son de inactividad, no absolutas.
# Igual que el refresh, para que las dos piezas caduquen juntas.
SESSION_TTL_HOURS=8

# Margen con el que el cliente deberia renovar ANTES de que caduque el
# acceso, en segundos. 300 = los ultimos 5 minutos de los 30. Lo publica
# el servicio para que el escritorio y el Electron sepan cuando pedir un
# refresh sin esperar a comerse un 401 a media operacion.
JWT_RENEW_BEFORE_SECONDS=300

# Tolerancia de reloj al validar `exp` / `nbf`, en segundos. Absorbe la
# deriva entre la maquina que firma y la que verifica. 10 s basta y es
# deliberadamente pequena: cuanto mas alta, mas vive un token caducado.
JWT_LEEWAY_SECONDS=10

# Cache en Redis de los LISTADOS del catalogo (books, authors), en
# segundos. 30 s es el compromiso: quita casi todo el trabajo repetido a
# PostgreSQL y, aun asi, un libro recien dado de alta aparece enseguida.
CACHE_TTL_SECONDS=30

# Cache del DETALLE de un recurso por clave, en segundos. Mas largo que
# el listado (60 s) porque un recurso concreto cambia menos a menudo que
# la coleccion a la que pertenece.
CACHE_DETAIL_TTL_SECONDS=60

# Cache de los permisos de un ROL, en segundos. 300 s porque el catalogo
# de roles casi nunca cambia y resolverlo en cada peticion seria una
# consulta a la base por llamada autenticada. El precio: tras editar los
# permisos de un rol, pueden tardar hasta 5 minutos en verse.
ROLE_CACHE_TTL_SECONDS=300


# =====================================================================
# 5. PostgreSQL — la fuente principal de datos  (CAMBIE LA CONTRASENA)
# =====================================================================
# La misma base para los seis servicios: Redis es cache y estado volatil,
# PostgreSQL es la verdad. Los seis se conectan con el mismo usuario y a
# la misma instancia, y cada uno se identifica ante el servidor con un
# application_name distinto (library-<servicio>-service), de modo que en
# pg_stat_activity se ve quien esta consultando que.

# localhost porque los servicios corren en la misma VM que PostgreSQL.
PGHOST=localhost
PGPORT=5432
PGDATABASE=library_db
PGUSER=library_user

# CAMBIEME. El enunciado fija 777 para el entorno local; en el servidor
# use una contrasena larga y aleatoria.
PGPASSWORD=CAMBIEME_contrasena_de_postgres

# Esquema donde viven las tablas del proyecto. Se puede dejar.
PGSCHEMA=library

# Pool de conexiones POR PROCESO. Con `gunicorn --workers 3` y seis
# servicios, el maximo teorico es 3 x DB_POOL_MAX x 6 = 180 conexiones:
# vigilelo contra el `max_connections` de PostgreSQL (100 por omision)
# antes de subir DB_POOL_MAX.
DB_POOL_MIN=1
DB_POOL_MAX=10

# Segundos para establecer la conexion con PostgreSQL. Igual que con
# Redis: fallar rapido y devolver 503 es mejor que dejar esperando.
DB_CONNECT_TIMEOUT=5


# =====================================================================
# 6. CORS
# =====================================================================
# Lista separada por comas de los origenes de las aplicaciones cliente.
#
# `*` SOLO sirve para desarrollo. En produccion ENUMERE los origenes,
# por dos razones:
#   1. `*` deja que cualquier pagina del mundo llame a la API desde el
#      navegador de un usuario autenticado.
#   2. `*` NO COMBINA CON COOKIES: login responde con
#      supports_credentials, y el navegador rechaza por norma la pareja
#      `Access-Control-Allow-Origin: *` + credenciales. Con `*` las
#      peticiones con cookie fallan en el cliente aunque el servidor
#      conteste 200.
#
# Ejemplo real:
#   CORS_ORIGINS=https://libreria.ejemplo.mx,http://localhost:3000
CORS_ORIGINS=*

# Segundos que el navegador puede cachear la respuesta al preflight
# OPTIONS. 86400 = 1 dia: evita un viaje de ida y vuelta extra por cada
# peticion. Se puede dejar.
CORS_MAX_AGE=86400


# =====================================================================
# 7. Representacion
# =====================================================================
# Formato cuando el cliente no pide ninguno (ni ?format= ni cabecera
# Accept). El enunciado de la practica exige XML por omision, y los
# clientes que prefieren JSON ya lo piden explicitamente con
# ?format=json. Dejelo en xml: cambiarlo rompe las pruebas y a los
# consumidores que no mandan Accept.
DEFAULT_FORMAT=xml


# =====================================================================
# RESUMEN: que hay que CAMBIAR antes de arrancar
# =====================================================================
#   JWT_SECRET_KEY    generelo y pongalo IGUAL en los seis servicios
#   SECRET_KEY        generelo (distinto del anterior)
#   REDIS_URL         la contrasena = requirepass de redis.conf
#   PGPASSWORD        la contrasena real de library_user
#   CORS_ORIGINS      enumere los origenes en produccion
#
# Lo demas se puede dejar tal cual. Si deja un valor CAMBIEME_*, el
# /health del servicio lo denuncia en su bloque `warnings` en lugar de
# arrancar fingiendo que esta configurado.
