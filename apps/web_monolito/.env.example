# ---------------------------------------------------------------
# Configuracion de la aplicacion monolitica
# Copiar como .env y ajustar los valores
# ---------------------------------------------------------------
PORT=3000
NODE_ENV=production

# PostgreSQL
PGHOST=localhost
PGPORT=5432
PGDATABASE=library_db
PGUSER=library_user
PGPASSWORD=777
PGSCHEMA=library

# Sesiones
SESSION_SECRET=cambia-esta-clave-por-una-larga-y-aleatoria

# Administrador inicial (se crea con: npm run db:setup)
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@library.local
ADMIN_PASSWORD=Admin123!

# Carga de imagenes
UPLOAD_MAX_MB=5
