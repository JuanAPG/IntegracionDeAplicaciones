# =====================================================================
# Librería en Línea — plantilla de configuración
#
#   cp .env.example .env      y edite los valores marcados como CAMBIEME
#
# ESTE ARCHIVO SÍ SE PUBLICA. El archivo .env que usted cree A PARTIR DE
# ÉL NO SE PUBLICA NUNCA: está en .gitignore y debe seguir estándolo.
#
# Regla: aquí solo van NOMBRES de variable y valores de ejemplo evidentes.
# Si alguna vez escribe aquí una contraseña real, deja de ser una plantilla
# y pasa a ser una filtración.
# =====================================================================


# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
PORT=3000

# development  muestra la traza completa en la página de error (solo local)
# production   oculta la traza. ÚSELO SIEMPRE en el servidor.
NODE_ENV=development

# Prefijo bajo el que se monta toda la aplicación.
# La página de inicio queda en  http://localhost:3000/library
# Use BASE_PATH=/ para montarla en la raíz del dominio.
BASE_PATH=/library


# ---------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=library_db
PGUSER=library_user
PGSCHEMA=library

# CAMBIEME. La contraseña del rol de PostgreSQL.
# El enunciado de la práctica fija 777 para el entorno local; esa contraseña
# NO debe salir de su máquina. En un servidor use una larga y aleatoria.
PGPASSWORD=CAMBIEME_contrasena_de_postgres


# ---------------------------------------------------------------------
# Sesiones
# ---------------------------------------------------------------------
# CAMBIEME. Firma las cookies de sesión. Si alguien la conoce, puede
# fabricar cookies válidas y entrar como cualquier usuario, incluido el
# administrador. Genérela así y péguela aquí:
#
#     node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
#
SESSION_SECRET=CAMBIEME_genere_una_cadena_larga_y_aleatoria


# ---------------------------------------------------------------------
# Administrador inicial
# Solo se usa la primera vez, al ejecutar:  npm run db:setup
# El sistema admite UN ÚNICO administrador (índice ux_users_single_admin).
# ---------------------------------------------------------------------
ADMIN_NAME=Administrador
ADMIN_EMAIL=admin@ejemplo.local

# CAMBIEME. Mínimo 6 caracteres (lo exige la aplicación); use bastantes más.
# Cámbiela otra vez desde "Mi perfil" tras el primer inicio de sesión.
ADMIN_PASSWORD=CAMBIEME_contrasena_del_administrador


# ---------------------------------------------------------------------
# Carga de imágenes de portada
# ---------------------------------------------------------------------
# Tamaño máximo por archivo, en megabytes.
# Si publica detrás de Nginx, client_max_body_size debe ser MAYOR que este
# valor; si no, el proxy corta la subida con un 413 antes de que la
# aplicación pueda dar un mensaje de validación.
UPLOAD_MAX_MB=5


# =====================================================================
# ANTES DE PUBLICAR EL REPOSITORIO — lista de comprobación
#
#   1. El archivo .env NO debe aparecer aquí:
#          git ls-files | grep -i "\.env"
#      Solo debe salir  apps/web_monolito/.env.example
#
#   2. Ningún secreto en el historial (no basta con borrarlo en un commit
#      posterior; queda en el historial y en cualquier copia ya clonada):
#          git log --all --name-only | grep -E "\.env$|\.pem$|id_rsa"
#
#   3. Ninguna credencial suelta en el código:
#          grep -rInE "(password|secret|token|api[_-]?key)\s*[:=]" \
#               --exclude-dir=node_modules --exclude=.env.example .
#
#   4. Revise capturas de pantalla y vídeos de la entrega: una terminal con
#      la cadena de conexión visible publica la credencial igual que un
#      archivo de texto.
#
#   5. Las cuentas de demostración de db/02_seed_30_per_table.sql comparten
#      la contraseña Demo123! y el administrador del seed usa Admin123!.
#      Son públicas a propósito para poder probar. ELIMÍNELAS antes de
#      exponer el sistema a Internet.
#
#   Si un secreto se publica por error: ROTE la credencial de inmediato.
#   Ese paso es el único imprescindible; limpiar el historial viene después.
#
#   Detalle completo en  apps/SEGURIDAD.txt
# =====================================================================
