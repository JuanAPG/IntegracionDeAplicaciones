<div class="page-head">
  <div>
    <p class="eyebrow">Concepto</p>
    <h1><%= concept.name %></h1>
    <p class="lead">
      Definiciones registradas en cada libro
      (dependencia (libro, concepto) &rarr; definicion).
    </p>
  </div>
  <div class="actions">
    <a class="btn btn-primary" href="<%= meta.basePath %>/<%= concept.id %>/edit">Editar concepto</a>
    <a class="btn btn-secondary" href="<%= meta.basePath %>">Volver</a>
  </div>
</div>

<div class="card">
  <% if (!definitions.length) { %>
    <p class="empty">Este concepto todavia no tiene definiciones asociadas a ningun libro.</p>
  <% } %>
  <% definitions.forEach(function (d) { %>
    <div class="concept" data-reveal>
      <p class="concept-name">
        <a href="<%= base %>/admin/books/<%= d.book_id %>/edit"><%= d.title %></a>
        <span class="badge mono">ISBN <%= d.isbn %></span>
      </p>
      <p class="concept-def"><%= d.definition %></p>
    </div>
  <% }); %>
</div>
