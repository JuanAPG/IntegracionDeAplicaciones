<div class="page-head">
  <div>
    <p class="eyebrow">Coleccion completa</p>
    <h1>Catalogo</h1>
    <p class="lead"><%= total %> libro<%= total === 1 ? '' : 's' %> disponible<%= total === 1 ? '' : 's' %>.</p>
  </div>
  <% if (isAdmin) { %>
    <a class="btn btn-secondary" href="/admin/books">Administrar libros</a>
  <% } %>
</div>

<div class="card">
  <form action="/catalog" method="GET" class="filters" role="search" aria-label="Filtrar catalogo">
    <div class="field">
      <label for="q">Buscar</label>
      <input type="search" id="q" name="q" value="<%= filters.search %>" placeholder="Titulo, ISBN o autor...">
    </div>
    <div class="field">
      <label for="author">Autor</label>
      <select id="author" name="author">
        <option value="">Todos</option>
        <% authorList.forEach(function (a) { %>
          <option value="<%= a.id %>" <%= filters.authorId === a.id ? 'selected' : '' %>><%= a.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label for="genre">Genero</label>
      <select id="genre" name="genre">
        <option value="">Todos</option>
        <% genreList.forEach(function (g) { %>
          <option value="<%= g.id %>" <%= filters.genreId === g.id ? 'selected' : '' %>><%= g.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label for="format">Formato</label>
      <select id="format" name="format">
        <option value="">Todos</option>
        <% formatList.forEach(function (f) { %>
          <option value="<%= f.id %>" <%= filters.formatId === f.id ? 'selected' : '' %>><%= f.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label for="category">Categoria</label>
      <select id="category" name="category">
        <option value="">Todas</option>
        <% categoryList.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= filters.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label for="order">Orden</label>
      <select id="order" name="order">
        <option value="recent" <%= order === 'recent' ? 'selected' : '' %>>Mas recientes</option>
        <option value="title" <%= order === 'title' ? 'selected' : '' %>>Titulo (A-Z)</option>
        <option value="price_asc" <%= order === 'price_asc' ? 'selected' : '' %>>Precio ascendente</option>
        <option value="price_desc" <%= order === 'price_desc' ? 'selected' : '' %>>Precio descendente</option>
        <option value="year_desc" <%= order === 'year_desc' ? 'selected' : '' %>>Ano (reciente)</option>
      </select>
    </div>
    <div class="field">
      <span class="label-text">Disponibilidad</span>
      <label class="check" for="available">
        <input type="checkbox" id="available" name="available" value="1" <%= filters.onlyAvailable ? 'checked' : '' %>>
        Solo con stock
      </label>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
        Filtrar
      </button>
      <a class="btn btn-secondary" href="/catalog">Limpiar</a>
    </div>
  </form>
</div>

<% if (!items.length) { %>
  <div class="card">
    <p class="empty">
      <svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="opacity:.5"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg><br>
      No se encontraron libros con esos criterios.
    </p>
  </div>
<% } else { %>
  <div class="grid grid-cards">
    <% items.forEach(function (b) { %>
      <article class="book-card" data-reveal>
        <a class="book-cover-link" href="/catalog/<%= b.id %>" tabindex="-1" aria-hidden="true">
          <% if (b.cover_url) { %>
            <img class="book-cover" src="<%= b.cover_url %>" alt="" loading="lazy" decoding="async">
          <% } else { %>
            <div class="book-cover-placeholder">
              <svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
              Sin portada
            </div>
          <% } %>
        </a>
        <div class="book-card-body">
          <h2 class="book-card-title"><a href="/catalog/<%= b.id %>"><%= b.title %></a></h2>
          <p class="hint"><%= b.authors || 'Sin autores registrados' %></p>
          <div class="badges">
            <span class="badge"><%= b.format_name %></span>
            <span class="badge"><%= b.publication_year %></span>
          </div>
          <div class="book-card-foot">
            <span class="price">$<%= Number(b.price).toFixed(2) %></span>
            <% if (b.stock > 0) { %>
              <span class="badge badge-stock-ok">Stock: <%= b.stock %></span>
            <% } else { %>
              <span class="badge badge-stock-out">Agotado</span>
            <% } %>
          </div>
        </div>
      </article>
    <% }); %>
  </div>
  <%- include('../../../views/partials/pagination') %>
<% } %>
