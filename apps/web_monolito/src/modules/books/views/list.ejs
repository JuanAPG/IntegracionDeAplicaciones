<div class="page-head">
  <div>
    <p class="eyebrow">Administracion</p>
    <h1>Libros</h1>
    <p class="lead">
      <%= total %> libro<%= total === 1 ? '' : 's' %> en el catalogo.
      ISBN &rarr; titulo, ano, precio, stock, formato y categoria.
    </p>
  </div>
  <a class="btn btn-primary" href="<%= base %>/admin/books/new">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M12 5v14"/></svg>
    Nuevo libro
  </a>
</div>

<div class="card">
  <form action="<%= base %>/admin/books" method="GET" class="filters" role="search">
    <div class="field">
      <label for="q">Buscar</label>
      <input type="search" id="q" name="q" value="<%= filters.search %>" placeholder="Titulo, ISBN o autor...">
    </div>
    <div class="field">
      <label for="genre">Genero</label>
      <select id="genre" name="genre">
        <option value="">Todos</option>
        <% genreList.forEach(function (g) { %>
          <option value="<%= g.id %>" <%= filters.genreId === g.id ? 'selected' : '' %>><%= g.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label for="format">Formato</label>
      <select id="format" name="format">
        <option value="">Todos</option>
        <% formatList.forEach(function (f) { %>
          <option value="<%= f.id %>" <%= filters.formatId === f.id ? 'selected' : '' %>><%= f.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label for="category">Categoria</label>
      <select id="category" name="category">
        <option value="">Todas</option>
        <% categoryList.forEach(function (c) { %>
          <option value="<%= c.id %>" <%= filters.categoryId === c.id ? 'selected' : '' %>><%= c.name %></option>
        <% }); %>
      </select>
    </div>
    <div class="field">
      <label for="order">Orden</label>
      <select id="order" name="order">
        <option value="recent" <%= order === 'recent' ? 'selected' : '' %>>Mas recientes</option>
        <option value="title" <%= order === 'title' ? 'selected' : '' %>>Titulo (A-Z)</option>
        <option value="price_asc" <%= order === 'price_asc' ? 'selected' : '' %>>Precio ascendente</option>
        <option value="price_desc" <%= order === 'price_desc' ? 'selected' : '' %>>Precio descendente</option>
        <option value="year_desc" <%= order === 'year_desc' ? 'selected' : '' %>>Ano (reciente)</option>
      </select>
    </div>
    <div class="form-actions">
      <button class="btn btn-primary" type="submit">Filtrar</button>
      <a class="btn btn-secondary" href="<%= base %>/admin/books">Limpiar</a>
    </div>
  </form>
</div>

<div class="card">
  <div class="table-wrap">
    <table>
      <thead>
        <tr>
          <th><span class="sr-only">Portada</span></th>
          <th>Titulo / Autores</th>
          <th>ISBN</th>
          <th>Clasificacion</th>
          <th class="num">Ano</th>
          <th class="num">Precio</th>
          <th class="num">Stock</th>
          <th class="num">Con. / Img.</th>
          <th><span class="sr-only">Acciones</span></th>
        </tr>
      </thead>
      <tbody>
        <% if (!items.length) { %><tr><td colspan="9" class="empty">No hay libros que coincidan con el filtro.</td></tr><% } %>
        <% items.forEach(function (b) { %>
          <tr>
            <td>
              <% if (b.cover_url) { %>
                <img class="thumb" src="<%= b.cover_url %>" alt="Portada de <%= b.title %>" loading="lazy" decoding="async">
              <% } else { %>
                <span class="badge">sin imagen</span>
              <% } %>
            </td>
            <td>
              <strong><a href="<%= base %>/catalog/<%= b.id %>"><%= b.title %></a></strong><br>
              <span class="hint"><%= b.authors || 'Sin autores' %></span>
            </td>
            <td class="mono hint"><%= b.isbn %></td>
            <td>
              <div class="badges">
                <span class="badge"><%= b.format_name %></span>
                <span class="badge"><%= b.category_name %></span>
                <% if (b.genres) { %><span class="badge"><%= b.genres %></span><% } %>
              </div>
            </td>
            <td class="num"><%= b.publication_year %></td>
            <td class="num"><span class="price" style="font-size:.95rem">$<%= Number(b.price).toFixed(2) %></span></td>
            <td class="num">
              <% if (b.stock > 0) { %>
                <span class="badge badge-stock-ok"><%= b.stock %></span>
              <% } else { %>
                <span class="badge badge-stock-out">0</span>
              <% } %>
            </td>
            <td class="num hint"><%= b.concepts_count %> / <%= b.images_count %></td>
            <td>
              <div class="actions">
                <a class="btn btn-secondary btn-sm" href="<%= base %>/admin/books/<%= b.id %>/edit">Editar</a>
                <form action="<%= base %>/admin/books/<%= b.id %>/delete" method="POST" class="inline"
                      onsubmit="return confirm('Eliminar el libro &quot;<%= b.title %>&quot; y todas sus relaciones?');">
                  <button class="btn btn-danger btn-sm" type="submit">Eliminar</button>
                </form>
              </div>
            </td>
          </tr>
        <% }); %>
      </tbody>
    </table>
  </div>
  <%- include('../../../views/partials/pagination') %>
</div>
