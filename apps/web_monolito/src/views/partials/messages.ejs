<% if (flash && (flash.success.length || flash.error.length || flash.info.length)) { %>
  <div class="messages" role="status" aria-live="polite">
    <% flash.success.forEach(function (msg) { %>
      <div class="alert alert-success">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.8 10A10 10 0 1 1 17 3.34"/><path d="m9 11 3 3L22 4"/></svg>
        <span><%= msg %></span>
      </div>
    <% }); %>
    <% flash.info.forEach(function (msg) { %>
      <div class="alert alert-info">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="M12 16v-4M12 8h.01"/></svg>
        <span><%= msg %></span>
      </div>
    <% }); %>
    <% flash.error.forEach(function (msg) { %>
      <div class="alert alert-error">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6M9 9l6 6"/></svg>
        <span><%= msg %></span>
      </div>
    <% }); %>
  </div>
<% } %>
