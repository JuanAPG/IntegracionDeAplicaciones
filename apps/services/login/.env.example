# =====================================================================
# apps/services/login/.env.example — plantilla de configuracion
#
#   cp .env.example .env      y escriba los valores reales en .env
#
# ESTE ARCHIVO SI SE PUBLICA. El .env que usted cree a partir de el NO:
# esta en apps/services/login/.gitignore y debe seguir estandolo.
# =====================================================================

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=5000
DEBUG=false

# CAMBIEME. Firma las cookies de sesion de Flask. Si alguien la conoce,
# puede fabricar sesiones validas y entrar como cualquier usuario.
# Generela asi y peguela aqui:
#     python3 -c "import secrets; print(secrets.token_hex(48))"
SECRET_KEY=CAMBIEME_secreto_de_sesion_flask

# ---------------------------------------------------------------------
# JWT (Bearer) — el mismo secreto en TODOS los micros (ver .env de la raiz)
# Las escrituras de libros exigen Authorization: Bearer <token> (1 h).
# Generelo asi y pegue el MISMO valor en cada servicio:
#     python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# ---------------------------------------------------------------------
# JWT_SECRET_KEY es el nombre vigente. JWT_SECRET se sigue aceptando
# (despliegues anteriores) pero el nuevo tiene prioridad.
JWT_SECRET_KEY=CAMBIEME_secreto_jwt_compartido
JWT_ALGORITHM=HS256

# 30 minutos, como fija el enunciado. Sustituye a JWT_EXPIRATION_HOURS,
# que ya no se lee: el token se renueva con POST /refresh antes de
# caducar, en lugar de durar una hora.
JWT_ACCESS_TTL_MINUTES=30
# Refresh token: 8 h, de un solo uso y con rotacion. Vive en Redis.
JWT_REFRESH_TTL_HOURS=8
# Margen con el que el cliente deberia renovar antes del vencimiento.
JWT_RENEW_BEFORE_SECONDS=300

# ---------------------------------------------------------------------
# Redis — OBLIGATORIO para este servicio
#
# Aqui viven la sesion, el refresh token y la lista de revocacion de
# JWT. Sin Redis, /login, /refresh, /logout y /session devuelven 503: es
# un fallo SEGURO y deliberado, porque emitir una credencial que despues
# no se pudiera revocar seria peor que rechazar la peticion.
#
# Formato: redis://:password@host:6379/0
# Los servicios de la VM usan 127.0.0.1 aunque Redis escuche en 0.0.0.0.
# ---------------------------------------------------------------------
REDIS_URL=redis://:CAMBIEME_contrasena_de_redis@127.0.0.1:6379/0
# Vida de la sesion en Redis (ventana deslizante: se renueva al usarla).
SESSION_TTL_HOURS=8

# ---------------------------------------------------------------------
# PostgreSQL (instancia CentOS: la misma base library_db del proyecto)
# ---------------------------------------------------------------------
PGHOST=localhost
PGPORT=5432
PGDATABASE=library_db
PGUSER=library_user
PGSCHEMA=library

# CAMBIEME. El enunciado de la practica fija 777 para el entorno local;
# en un servidor use una contrasena larga y aleatoria.
PGPASSWORD=CAMBIEME_contrasena_de_postgres

DB_POOL_MIN=1
DB_POOL_MAX=10
DB_CONNECT_TIMEOUT=5

# ---------------------------------------------------------------------
# Sesion Flask
#
# La cookie ya NO lleva el estado de la sesion, solo su identificador
# (sid): el estado vive en Redis y por eso una sesion se puede cerrar
# desde el servidor. Su duracion la fija SESSION_TTL_HOURS, arriba.
# ---------------------------------------------------------------------
# En produccion detras de HTTPS ponga true.
SESSION_COOKIE_SECURE=false

# ---------------------------------------------------------------------
# CORS — el servicio se consume desde clientes de otro dominio.
# Como /login usa cookies de sesion, supports_credentials es true y el
# navegador rechaza "*" : en produccion enumere los origenes, por ejemplo:
#   CORS_ORIGINS=https://libreria.ejemplo.mx,http://localhost:3000
# ---------------------------------------------------------------------
CORS_ORIGINS=*
CORS_MAX_AGE=86400

# ---------------------------------------------------------------------
# Representacion
# ---------------------------------------------------------------------
# Formato cuando el cliente no pide ninguno (?format= / cabecera Accept).
# El enunciado exige XML por omision.
DEFAULT_FORMAT=xml
XML_NAMESPACE=urn:library:auth:1.0
XML_VERSION=1.0

# ---------------------------------------------------------------------
# Correo (sendmail alojado en la instancia, NO POP/IMAP)
# ---------------------------------------------------------------------
# El microservicio entrega el mensaje con smtplib al sendmail local.
SMTP_HOST=localhost
SMTP_PORT=25
SMTP_TIMEOUT=10
# Remitente visible del correo de verificacion.
SMTP_FROM=noreply@libreria.local
# Nombre del servicio en el asunto/cuerpo del correo.
MAIL_SERVICE_NAME=Libreria en Linea
# Base publica para construir el enlace de verificacion. Vacio = se usa
# el Host de la peticion que registro al usuario.
MAIL_VERIFY_BASE_URL=
# Vigencia del token de verificacion.
TOKEN_TTL_HOURS=48

# ---------------------------------------------------------------------
# Contrasenas (bcrypt, compatible con los hashes bcryptjs del monolito)
# ---------------------------------------------------------------------
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=6
