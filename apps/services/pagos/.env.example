# =====================================================================
# apps/services/pagos/.env.example — plantilla de configuracion
#
#   cp .env.example .env      y escriba los valores reales en .env
#
# ESTE ARCHIVO SI SE PUBLICA. El .env que usted cree a partir de el NO:
# esta en apps/services/pagos/.gitignore y debe seguir estandolo.
#
# LO COMPARTIDO VA EN EL .env DE LA RAIZ
# -------------------------------------
# JWT_SECRET_KEY, REDIS_URL y las credenciales de PostgreSQL se leen del
# .env de la RAIZ del repo, para que los seis microservicios compartan
# exactamente los mismos valores sin copiarlos seis veces. Aqui se
# repiten COMENTADOS solo como referencia: descomentelos unicamente si
# este servicio corre en otra maquina y necesita valores propios.
#
# Precedencia: entorno real > .env de la raiz > este archivo.
# =====================================================================

# ---------------------------------------------------------------------
# Servidor
# ---------------------------------------------------------------------
HOST=0.0.0.0
PORT=5005
DEBUG=false

# Prefijo bajo el que cuelgan los recursos. Vacio por omision: las rutas
# son /pagos y no /api/pagos.
API_PREFIX=

# ---------------------------------------------------------------------
# Visibilidad de este servicio
#
# Aqui NADA es publico, ni siquiera el catalogo de metodos de pago:
# un pago es informacion financiera de una persona concreta.
# ---------------------------------------------------------------------

# ---------------------------------------------------------------------
# Representacion
# ---------------------------------------------------------------------
# Formato cuando el cliente no pide ninguno (?format= / cabecera Accept).
# El enunciado exige XML por omision.
DEFAULT_FORMAT=xml
XML_NAMESPACE=urn:library:payments:1.0
XML_VERSION=1.0

# ---------------------------------------------------------------------
# CORS — el servicio se consume desde clientes de otro dominio.
# Este servicio NO usa cookies (la identidad viaja en el JWT), de modo
# que "*" funciona en desarrollo. En PRODUCCION enumere los origenes de
# las aplicaciones cliente; /health lo recuerda mientras siga en "*".
# ---------------------------------------------------------------------
CORS_ORIGINS=*
CORS_MAX_AGE=86400

# ---------------------------------------------------------------------
# Paginacion
# ---------------------------------------------------------------------
DEFAULT_LIMIT=50
MAX_LIMIT=200

# ---------------------------------------------------------------------
# Cache de lecturas (Redis)
#
# TTL CORTO a proposito: la invalidacion explicita tras cada escritura es
# el mecanismo principal; el TTL es la red de seguridad por si una
# invalidacion se pierde con Redis caido.
#
# CACHE_ENABLED=false apaga el cache sin tocar codigo (util para medir).
# ---------------------------------------------------------------------
CACHE_ENABLED=true
CACHE_TTL_SECONDS=30
CACHE_DETAIL_TTL_SECONDS=60

# ---------------------------------------------------------------------
# VALORES COMPARTIDOS — normalmente NO se tocan aqui.
# Descomente solo si este servicio necesita valores distintos a los del
# .env de la raiz (por ejemplo, si corre en otra maquina).
# ---------------------------------------------------------------------
# El MISMO secreto en los seis servicios, o los tokens no se verifican.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
#JWT_SECRET_KEY=CAMBIEME_secreto_jwt_compartido
#JWT_ALGORITHM=HS256
#JWT_ACCESS_TTL_MINUTES=30

# Redis. Sin el, este servicio no puede comprobar la revocacion de
# tokens y rechaza toda peticion autenticada con 503 (fallo seguro).
#REDIS_URL=redis://:CAMBIEME_contrasena_de_redis@127.0.0.1:6379/0
#REDIS_CONNECT_TIMEOUT=2
#REDIS_SOCKET_TIMEOUT=2
# Vigencia del cache de permisos por rol (library.role_permissions).
#ROLE_CACHE_TTL_SECONDS=300

# PostgreSQL: la fuente principal de datos.
#PGHOST=localhost
#PGPORT=5432
#PGDATABASE=library_db
#PGUSER=library_user
#PGPASSWORD=CAMBIEME_contrasena_de_postgres
#PGSCHEMA=library
#DB_POOL_MIN=1
#DB_POOL_MAX=10
#DB_CONNECT_TIMEOUT=5
